AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_RATE_LIMIT_LOGIN_IP_ATTEMPTS=100
AUTH_RATE_LIMIT_LOGIN_ACCOUNT_FAILURES=20
AUTH_RATE_LIMIT_PASSWORD_RECOVERY_IP_ATTEMPTS=30
AUTH_RATE_LIMIT_PASSWORD_RECOVERY_EMAIL_ATTEMPTS=5
AUTH_RATE_LIMIT_INVITE_IP_ATTEMPTS=100
AUTH_RATE_LIMIT_MAX_BUCKETS=10000
AUTH_RATE_LIMIT_IDENTITY_MAX_LENGTH=256
AUTH_RATE_LIMIT_TRUSTED_PROXY_IPS=127.0.0.1,::1
AUTH_RATE_LIMIT_CLIENT_IP_HEADER=
